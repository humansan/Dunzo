# ---- server-only (NO VITE_ prefix; never commit real values) ----
# Neon Postgres connection string. Use the dev branch while building.
# Read by drizzle.config.ts and the backend; never shipped to the browser.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Neon Auth base URL (server copy, NO VITE_ prefix). Used by the backend both to
# fetch the JWKS / verify session tokens AND as the target of the same-origin auth
# proxy in server/app.ts. This is the real Neon URL (unlike the client value below).
NEON_AUTH_URL="https://your-project.neon.tech/auth"

# ---- client/browser (VITE_ prefix = bundled into the frontend; publishable only) ----
# The browser talks to Neon Auth through a same-origin reverse proxy so the session
# cookie is first-party (fixes iOS/Safari dropping a third-party cookie). Keep this
# as the relative path; the backend proxies /api/neon-auth → NEON_AUTH_URL.
VITE_NEON_AUTH_URL="/api/neon-auth"
