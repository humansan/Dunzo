---
/**
 * Home — ten sections, in the order a visitor should meet them: hook, the core
 * idea, each surface in the order you'd actually use them, the reward system,
 * credibility, close.
 *
 * H10 (the closing CTA band) is rendered by Base.astro on every page.
 * Section copy and layout: website/website plan.md §5.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import TwoSurfaces from '../components/home/TwoSurfaces.astro';
import Daily from '../components/home/Daily.astro';
import Planner from '../components/home/Planner.astro';
import Collections from '../components/home/Collections.astro';
import Calendar from '../components/home/Calendar.astro';
import Xp from '../components/home/Xp.astro';
import Stats from '../components/home/Stats.astro';
import Grid from '../components/home/Grid.astro';
import { TAGLINE } from '../config';
---

<Base title={`Dunzo — ${TAGLINE}`}>
  <Hero />
  <TwoSurfaces />
  <Daily />
  <Planner />
  <Collections />
  <Calendar />
  <Xp />
  <Stats />
  <Grid />
</Base>
