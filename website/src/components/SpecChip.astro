---
/**
 * SpecChip — a small pill for naming a mechanic inline: "Ctrl+K", "5 XP tiers",
 * "1 / 3 / 5 / 7 days". Specifics are the proof, so these carry a lot of the
 * persuasion work. Mono by default because most of them are values.
 */
interface Props {
  /** `gold` for the rare chip that should be an earned moment, not a label. */
  tone?: 'neutral' | 'gold';
  /** Set false for prose-y chips ("Drag to reorder") that shouldn't be mono. */
  mono?: boolean;
  class?: string;
}

const { tone = 'neutral', mono = true, class: className = '' } = Astro.props;
---

<span class:list={['chip', `chip--${tone}`, { 'chip--mono': mono }, className]}>
  <slot />
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 5px 11px;
    border-radius: var(--radius-chip);
    font-size: var(--text-caption);
    line-height: 1.35;
    white-space: nowrap;
  }

  .chip--mono {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    font-weight: var(--weight-medium);
  }

  .chip--neutral {
    background: var(--fill-subtle);
    color: var(--fg-faint);
  }

  .chip--gold {
    background: rgb(255 205 78 / 0.12);
    color: var(--gold);
  }
</style>
