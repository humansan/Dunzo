---
/**
 * Section — the standard eyebrow + H2 + deck header, plus a slot for the body.
 *
 * Every content section on the site uses this so the vertical rhythm and header
 * treatment stay identical. `align="center"` for full-width sections, the default
 * `"start"` for the asymmetric media-beside-copy ones.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  deck?: string;
  align?: 'start' | 'center';
  /** Anchor target — used by the /features scroll-spy rail and footer links. */
  id?: string;
  /** Visual treatment: flat canvas (default), a gold glow, or a --surface band. */
  variant?: 'plain' | 'lift' | 'band';
  /**
   * Heading level for `title`. Sections are h2 by default; the opening section of
   * a page that has no separate hero passes `as="h1"` so the page isn't published
   * without one. Styling is driven by the `.title` class, not the tag, so an h1
   * here still reads at section scale.
   */
  as?: 'h1' | 'h2';
  class?: string;
}

const {
  eyebrow,
  title,
  deck,
  align = 'start',
  id,
  variant = 'plain',
  as: Heading = 'h2',
  class: className = '',
} = Astro.props;

const hasHeader = Boolean(eyebrow || title || deck);
const variantClass = variant === 'plain' ? '' : `section--${variant}`;
---

<section
  id={id}
  class:list={['section', variantClass, className]}
  data-align={align}
>
  <div class="container">
    {
      hasHeader && (
        <header class="head" data-align={align}>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <Heading class="title">{title}</Heading>}
          {deck && <p class="deck">{deck}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .head[data-align='center'] {
    align-items: center;
    text-align: center;
  }

  .head[data-align='center'] :global(.deck) {
    margin-inline: auto;
  }

  /* Section headings always read at section scale, whether they're h1 or h2 —
     the tag carries document structure, the class carries size. */
  .head :global(.title) {
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
    line-height: var(--leading-tight);
  }

  /* A heading wants a tighter gap to its eyebrow than to its deck. */
  .head .eyebrow + :global(.title) {
    margin-top: calc(var(--space-2) * -1);
  }
</style>
