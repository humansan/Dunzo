---
/**
 * SpecList — the two-column definition list that carries the reference content on
 * /features. Term left, definition right, hairline between rows. Collapses to a
 * stacked list below 640px.
 *
 * Definitions may contain inline HTML (a <code> value, an <em>), so they render
 * with set:html. Content is authored by us, never user input.
 */
interface Spec {
  term: string;
  def: string;
}

interface Props {
  items: Spec[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<dl class:list={['specs', className]}>
  {
    items.map(({ term, def }) => (
      <div class="row">
        <dt>{term}</dt>
        <dd set:html={def} />
      </div>
    ))
  }
</dl>

<style>
  .specs {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) 2.2fr;
    gap: var(--space-6);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-subtle);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line-subtle);
  }

  dt {
    color: var(--fg);
    font-weight: var(--weight-semi);
  }

  dd {
    color: var(--fg-subtle);
  }

  dd :global(code) {
    background: var(--fill-subtle);
    padding: 2px 6px;
    border-radius: 6px;
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
