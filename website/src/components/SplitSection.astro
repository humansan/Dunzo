---
/**
 * SplitSection — the asymmetric media-beside-copy layout (7 columns of media, 5
 * of copy). H3 runs it media-left; H4 passes `reverse` to mirror it.
 *
 * On mobile both orders collapse to media-then-copy: the screenshot is the hook,
 * and DOM order alone would put H4's copy first.
 */
interface Props {
  /** Mirror the layout — media right, copy left. */
  reverse?: boolean;
  class?: string;
}

const { reverse = false, class: className = '' } = Astro.props;
---

<div class:list={['split', { reverse }, className]}>
  <div class="media">
    <slot name="media" />
  </div>
  <div class="copy">
    <slot name="copy" />
  </div>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(var(--space-8), 4vw, var(--space-16));
    align-items: center;
  }

  .reverse .media {
    order: 2;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .media {
    min-width: 0; /* lets the frame shrink inside the grid track */
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    /* Media leads on mobile regardless of desktop order. */
    .reverse .media {
      order: 0;
    }
  }
</style>
