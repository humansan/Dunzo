---
/**
 * XpTriptych — the three states of the XP bar, side by side, each captioned with
 * the status text the app actually shows.
 *
 * The three crops MUST be identical dimensions (plan §9, S12a/b/c) or the
 * progression reads as three unrelated screenshots instead of one bar changing.
 * The shared `ratio` here is what enforces that on the page; the capture session
 * has to match it.
 */
import DeviceFrame from './DeviceFrame.astro';

const RATIO = '21/6';

const states = [
  {
    label: 'S12a',
    note: 'XP bar below target — neutral, 1 star lit',
    caption: '2 XP to reach yesterday',
    tone: 'neutral',
  },
  {
    label: 'S12b',
    note: 'XP bar gold — yesterday beaten, 2 stars lit',
    caption: 'Yesterday beat! · 7 XP to 7-day best',
    tone: 'gold',
  },
  {
    label: 'S12c',
    note: 'XP bar violet — 7-day best beaten, 3 stars lit',
    caption: 'Ahead of your 7-day best',
    tone: 'violet',
  },
];
---

<div class="triptych">
  {
    states.map((s) => (
      <figure class:list={['state', `is-${s.tone}`]}>
        <DeviceFrame type="placeholder" label={s.label} note={s.note} ratio={RATIO} />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .triptych {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .state {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-align: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-chip);
  }

  /* The caption carries the state's color, so the progression reads even while
     the crops are still placeholders. */
  .is-neutral figcaption {
    color: var(--fg-faint);
    background: var(--fill-subtle);
  }

  .is-gold figcaption {
    color: var(--gold);
    background: rgb(255 205 78 / 0.12);
  }

  .is-violet figcaption {
    color: var(--violet);
    background: rgb(167 139 250 / 0.14);
  }

  @media (max-width: 900px) {
    .triptych {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
