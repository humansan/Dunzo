---
/**
 * FeatureRow — gold icon, bold title, one line of copy. The repeating unit in the
 * copy column of H3 and H4.
 *
 * Copy comes through the default slot rather than a prop so it can carry inline
 * <code> for the values that do the persuading (`july 12`, `3p`, `33%`).
 */
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<div class="row">
  <span class="ico">
    <Icon name={icon as any} size={18} />
  </span>
  <div class="text">
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-chip);
    background: rgb(255 205 78 / 0.1);
    flex-shrink: 0;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  h3 {
    font-size: var(--text-body);
    font-weight: var(--weight-semi);
    color: var(--fg);
    line-height: 1.4;
  }

  p {
    color: var(--fg-subtle);
    font-size: var(--text-caption);
    line-height: 1.6;
  }

  p :global(code) {
    background: var(--fill-subtle);
    padding: 1px 6px;
    border-radius: 5px;
    color: var(--fg-muted);
    white-space: nowrap;
  }
</style>
