---
/**
 * H9 — Focus, search, and the small stuff. Six cards for everything that doesn't
 * need its own section but proves the app is finished software.
 */
import Section from '../Section.astro';
import FeatureCard from '../FeatureCard.astro';
---

<Section
  id="more"
  eyebrow="And the rest"
  title="The small stuff, done properly."
  deck="None of this needs its own section. All of it is the reason the app feels finished."
  align="center"
  data-reveal
>
  <div class="grid">
    <FeatureCard
      icon="timer"
      title="Stopwatch, timer, pomodoro"
      asset="S16"
      assetNote="Focus, fullscreen pomodoro mid-session"
    >
      Three modes in one tool. Full-screen when you want the clock, a floating card when you want
      the app. Sessions survive a page reload.
    </FeatureCard>

    <FeatureCard icon="circle-dot" title="Pomodoro that respects you">
      Focus, short break, long break with cycle dots. Breaks auto-start; the next focus block
      doesn’t — going back to work stays a decision.
    </FeatureCard>

    <FeatureCard icon="keyboard" title="Durations you can type">
      <code>25</code>, <code>90m</code>, <code>1h30</code>, <code>1:30:00</code>,
      <code>90 minutes</code> — all understood. Run over and it counts up in overtime instead of
      stopping.
    </FeatureCard>

    <FeatureCard
      icon="search"
      title="Ctrl+K finds anything"
      asset="S17"
      assetNote="Task finder, list mode with a fuzzy query"
    >
      Fuzzy search across names, notes, collections, and fields — the same engine that picks a
      parent task. List or table.
    </FeatureCard>

    <FeatureCard
      icon="chart-column"
      title="Time trackers"
      asset="S15"
      assetNote="Trackers in grid mode, four widgets at different fills"
    >
      Widgets that count down a day, week, month, year, or a custom span. Pick the color, pick what
      the big number shows.
    </FeatureCard>

    <FeatureCard
      icon="sliders-horizontal"
      title="Themes and settings"
      asset="S18"
      assetNote="Settings modal, Settings tab"
    >
      Classic and Gruvbox, dark and light. Set your first day of week, your default XP, and what new
      tasks do by default.
    </FeatureCard>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    text-align: left;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
