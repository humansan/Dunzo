---
/**
 * H3 — The daily list. Media left, copy right (plan §5).
 */
import Section from '../Section.astro';
import SplitSection from '../SplitSection.astro';
import DeviceFrame from '../DeviceFrame.astro';
import FeatureRow from '../FeatureRow.astro';
import SpecChip from '../SpecChip.astro';

const strip = [
  'Week strip',
  'Today button',
  'Full calendar picker',
  'Drag to reorder',
  'Archived tasks still show here',
];
---

<Section
  id="daily"
  eyebrow="Do"
  title="Today fits on one screen."
  deck="The daily page is the tasks due today, a week strip to move between days, and a live one-day calendar down the right side. Everything else in the app is one click away and none of it is in your face."
  data-reveal
>
  <SplitSection>
    <Fragment slot="media">
      <DeviceFrame
        type="placeholder"
        label="V7"
        note="Add a todo — type a title, type “july 12” into the date chip, “3p” into the time chip, set 3 XP"
        ratio="16/10"
      />
      <DeviceFrame
        type="placeholder"
        label="S3"
        note="Quick edit panel, every field filled"
        ratio="16/7"
      />
    </Fragment>

    <Fragment slot="copy">
      <FeatureRow icon="circle-check-big" title="Check and it’s done.">
        Click the circle. The row grays out, the XP lands, and the bar at the bottom moves.
      </FeatureRow>
      <FeatureRow icon="mouse-pointer-click" title="Everything from the row.">
        Right-click any task for date, time, priority, XP, collection, and parent — without opening
        anything.
      </FeatureRow>
      <FeatureRow icon="list-plus" title="Add in one line.">
        “Add a todo” opens a quick-edit panel: title, notes, due date and time, XP, status,
        priority, collection, parent.
      </FeatureRow>
      <FeatureRow icon="keyboard" title="Dates you can type.">
        The date field takes <code>07/12/26</code>, <code>july 12</code>, or
        <code>july 14, 2026</code>. The time field takes <code>3p</code>, <code>2:45 am</code>, or
        <code>33%</code> — a percentage of the day elapsed.
      </FeatureRow>
      <FeatureRow icon="gauge" title="Time trackers down the left.">
        Live progress bars for the day, the month, the year, or any custom span you define.
      </FeatureRow>
    </Fragment>
  </SplitSection>

  <div class="strip" data-reveal>
    {strip.map((s) => <SpecChip mono={false}>{s}</SpecChip>)}
  </div>
</Section>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line-subtle);
  }
</style>
