---
/**
 * H8 — Stats. Short and media-forward; the receipts after the XP section's pitch.
 */
import Section from '../Section.astro';
import SplitSection from '../SplitSection.astro';
import DeviceFrame from '../DeviceFrame.astro';
import SpecChip from '../SpecChip.astro';
---

<Section
  id="stats"
  eyebrow="Look back"
  title="Proof you did the work."
  deck="The stats page keeps your streak, your best day, your total XP, and rolling 7-, 30-, and 365-day totals against the periods before them. There’s an XP history chart at four zoom levels, a breakdown of where the XP came from by collection, and a full log of every scoring task — exportable as CSV."
  data-reveal
>
  <SplitSection>
    <Fragment slot="media">
      <DeviceFrame
        type="placeholder"
        label="S14"
        note="Stats page — streak badge, best day, total XP, the three period cards, and the history chart"
        ratio="4/3"
      />
    </Fragment>

    <Fragment slot="copy">
      <DeviceFrame
        type="placeholder"
        label="S14b"
        note="Collection breakdown bar, cropped"
        ratio="16/5"
      />
      <div class="chips">
        <SpecChip>Day / 4 days / Week / Month</SpecChip>
        <SpecChip mono={false}>Collection breakdown</SpecChip>
        <SpecChip tone="gold">Export CSV</SpecChip>
      </div>
    </Fragment>
  </SplitSection>
</Section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
