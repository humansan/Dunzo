---
/**
 * H6 — The calendar. Centered header, full-width media, 4-up spec row beneath.
 */
import Section from '../Section.astro';
import DeviceFrame from '../DeviceFrame.astro';

const specs = [
  { term: '1, 3, 5, or 7 days', def: 'Change the span from the header. Today jumps back.' },
  { term: 'Overlap lanes', def: 'Conflicting blocks indent into lanes. Hover brings one forward.' },
  {
    term: 'Filter what shows',
    def: 'Daily tasks, planner tasks, uncategorized, archived — each a toggle.',
  },
  {
    term: 'Per-collection visibility',
    def: 'Click a collection to hide it. Hide all, show all, with a prompt for subcollections.',
  },
];
---

<Section
  id="calendar"
  eyebrow="Schedule"
  title="Drag a task onto a time."
  deck="Click and drag on the grid to create a task at that slot. Drag its edges to change how long it takes, drag the block itself to move it to another day. Blocks are colored by collection."
  align="center"
  data-reveal
>
  <DeviceFrame
    type="placeholder"
    label="V3"
    note="Drag onto a time — drag-create a block on Wednesday, drag its edge to resize, drag it to Thursday"
    ratio="16/9"
  />

  <div class="specs" data-reveal>
    {
      specs.map((s) => (
        <div class="spec">
          <h3>{s.term}</h3>
          <p>{s.def}</p>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .spec h3 {
    font-size: var(--text-body);
    font-weight: var(--weight-semi);
    color: var(--fg);
  }

  .spec p {
    font-size: var(--text-caption);
    color: var(--fg-subtle);
  }

  @media (max-width: 900px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .specs {
      grid-template-columns: 1fr;
    }
  }
</style>
