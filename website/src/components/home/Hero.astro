---
/**
 * H1 — Hero. The first of the two structural placements of background.jpg
 * (plan §3): full-bleed, pushed far back at blur(64px), with a bottom-heavy
 * scrim so the headline sits on near-solid canvas while color bleeds from the
 * top corners.
 *
 * Flat and confident — no 3D tilt on the media frame.
 */
import DeviceFrame from '../DeviceFrame.astro';
import { getBackground } from '../../lib/background';
import { TAGLINE, SUBHEAD, APP_URL } from '../../config';

// Shared with the CTA band so the image downloads once — see lib/background.ts.
const bg = await getBackground();
---

<section class="hero">
  <div class="bg-wrap" aria-hidden="true">
    <img class="bg" src={bg.src} alt="" loading="eager" fetchpriority="high" decoding="async" />
    <div class="scrim"></div>
  </div>

  <div class="container inner">
    <h1>{TAGLINE}</h1>
    <p class="sub">{SUBHEAD}</p>

    <div class="ctas">
      <a class="btn btn--primary" href={APP_URL}>Start free &rarr;</a>
      <a class="btn btn--secondary" href="/how-it-works">See how it works</a>
    </div>

    <div class="media">
      <DeviceFrame
        type="placeholder"
        label="V1"
        note="The day getting done — check off two tasks, the XP bar fills gold, a star lights, the streak ticks up"
        ratio="16/10"
      />
    </div>

    <p class="trust">Free &middot; Works in your browser &middot; Your data exports</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(72px, 4rem + 5vw, 140px) var(--section-y);
    overflow: hidden;
  }

  .bg-wrap {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(64px) saturate(1.15) brightness(1.05);
    /* Scaled past the frame so the blur never feathers in from the edges. */
    transform: scale(1.25);
    opacity: 0.38;
  }

  /* Bottom-heavy: color at the top corners, solid canvas by the time the eye
     reaches the media frame. */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(17 17 17 / 0.55) 0%,
      rgb(17 17 17 / 0.82) 55%,
      var(--canvas) 100%
    );
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  .sub {
    font-size: var(--text-deck);
    color: var(--fg-subtle);
    max-width: var(--measure-sub);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* Bleeds slightly past the container without ever causing a horizontal
     scrollbar — min() clamps it to the viewport on narrow screens. */
  .media {
    width: min(1100px, 100%);
    margin-top: var(--space-10);
  }

  .trust {
    font-size: 13px;
    color: var(--fg-ghost);
  }

  @media (min-width: 1240px) {
    .media {
      width: 1100px;
      max-width: none;
    }
  }
</style>
