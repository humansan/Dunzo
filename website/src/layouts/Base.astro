---
// The page shell: head, nav, content, CTA band, footer.
// OG tags, JSON-LD, and canonical URLs land in Phase 7.
//
// `wght.css` rather than `index.css`: weight axis, normal style only — no italic
// files in the build. Both families ship unicode-range'd subsets, so latin-ext
// and vietnamese are never fetched for English copy.
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { SUBHEAD } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Keep a page out of search results (the kitchen sink). */
  noindex?: boolean;
  /** Suppress the closing CTA band — utility pages only. */
  noCta?: boolean;
}

const { title, description = SUBHEAD, noindex = false, noCta = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111111" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Runs before paint: adds `.js` so the reveal styles apply only when the
      // observer below will actually run. Without this, a JS failure would leave
      // every [data-reveal] section permanently invisible.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {!noCta && <CtaBand />}
    <Footer />

    <script>
      // Reveal-on-scroll. Reveals once and unobserves — nothing animates back out
      // on scroll-up. Phase 7 tunes stagger and distance; the wiring is done.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!('IntersectionObserver' in window)) {
        // No observer: show everything rather than hide it.
        targets.forEach((el) => el.setAttribute('data-revealed', ''));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-revealed', '');
              io.unobserve(entry.target);
            }
          },
          // Fire slightly before the element's top edge arrives, so the motion
          // reads as the section settling rather than popping in late.
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
