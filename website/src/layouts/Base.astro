---
// Nav, Footer, and CtaBand land in Phase 3; OG tags, JSON-LD, and canonical in
// Phase 7.
//
// `wght.css` rather than `index.css`: weight axis, normal style only — no italic
// files in the build. Both families ship unicode-range'd subsets, so latin-ext
// and vietnamese are never fetched for English copy.
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Keep a page out of search results (the kitchen sink). */
  noindex?: boolean;
}

const {
  title,
  description = 'Dunzo pairs a strategic planner and calendar for the big picture with a daily list that keeps you focused on today. Finish it to earn XP, stars, and keep the streak alive.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
